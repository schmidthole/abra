#!/usr/bin/env node
import { parseArgs } from 'node:util';
import { runWatch } from '../extensions/linear/watch.mjs';
import { WatchFailure, failureCode, diagnosticText } from '../extensions/linear/diagnostics.mjs';

try {
  let values;
  try { ({ values } = parseArgs({ options: { help: { type: 'boolean' }, pi: { type: 'string', default: 'pi' }, 'trusted-managed-work': { type: 'boolean', default: false } }, strict: true, allowPositionals: false })); }
  catch { throw new WatchFailure('options-invalid'); }
  if (values.help) {
    process.stdout.write('usage: bin/linear-watch --trusted-managed-work [--pi /absolute/path/to/pi]\n\nposix foreground only; one persisted rpc child per confirmed safe handoff.\nrequires .pi/abra-linear.json watch.trustedManagedWork=true, configured credentials,\ntrusted project and compatible pi-subagents native proof api.\nacknowledgment forbids detached/untracked/nested/external writers; not a sandbox.\nstatus is plain-language on stderr, with unchanged polls quiet and a heartbeat about once a minute.\nctrl-c stops admission and requests shutdown; uncertain owners require manual recovery.\nno model, linear or process is started by --help. see docs/linear-polling.md.\n');
  } else {
    const controller = new AbortController();
    const stop = () => controller.abort();
    process.on('SIGINT', stop); process.on('SIGTERM', stop);
    try { await runWatch({ pi: values.pi, acknowledge: values['trusted-managed-work'], signal: controller.signal }); }
    finally { process.off('SIGINT', stop); process.off('SIGTERM', stop); }
  }
} catch (error) {
  process.stderr.write(`linear watch: unable to continue while ${failureCode(error) === 'options-invalid' ? 'checking command options' : 'running watch'}: ${diagnosticText(failureCode(error))}. action needed: check command options (--help), .pi/abra-linear.json, credentials and pi compatibility; if a session started, preserve connector receipts and reconcile saved session/task/worker ownership before restarting. no automatic retry or lock removal. see docs/linear-polling.md.\n`);
  process.exitCode = 1;
}
